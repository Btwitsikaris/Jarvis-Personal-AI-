# Keep these server-side. NEVER put them in VITE_* variables.
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key

# --- Optional hardening (recommended for any public deployment) ---
# If set, every API call must send this code; the app prompts for it once per browser.
ACCESS_CODE=choose-a-long-random-passphrase
# Max API requests per minute per IP, per route (default 20).
# RATE_LIMIT_PER_MIN=20
# Extra allowed browser origins (comma-separated) if you use a custom domain different from the deploy host.
# ALLOWED_ORIGINS=https://my-domain.com
# Override the Groq model (default: openai/gpt-oss-20b).
# GROQ_MODEL=openai/gpt-oss-20b
